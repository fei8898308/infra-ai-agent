# Copy to .env and generate a fresh token (see scripts/init_env.py).
WEBHOOK_TOKEN=
DRY_RUN=true

# Container DNS on /opt/agent-lab's existing Docker network.
FLOWISE_BASE_URL=http://flowise:3000
FLOWISE_CHATFLOW_ID=
FLOWISE_API_KEY=
# Set true only after reviewing the dedicated, tool-free Qwen3 chatflow.
FLOWISE_READ_ONLY_CONFIRMED=false
# Explicit opt-in required for live HTTP inside the trusted Docker lab network.
FLOWISE_ALLOW_INSECURE_HTTP=false
FLOWISE_TIMEOUT_SECONDS=45

MAX_BODY_BYTES=65536
BODY_TIMEOUT_SECONDS=10
DEDUP_TTL_SECONDS=300
DEDUP_MAX_ENTRIES=1024
MAX_INFLIGHT=2

AGENT_LAB_NETWORK=agent-lab_agent-net
WEBHOOK_PORT=8088

# Alternative to inline credentials: unset the corresponding variable above,
# set WEBHOOK_TOKEN_FILE / FLOWISE_API_KEY_FILE, and mount each file read-only
# into the API container using an operator-owned Compose override.
